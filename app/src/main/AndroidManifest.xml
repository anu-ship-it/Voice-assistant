<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.alpha.voiceassistant">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 14+ requires declaring the foreground service type explicitly
         if you later switch to always-listening. Not needed for push-to-talk. -->

    <application
        android:allowBackup="true"
        android:label="Voice Assistant"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.AppCompat.Light">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ui.TriggerTileService"
            android:exported="true"
            android:icon="@drawable/ic_mic"
            android:label="Voice Assistant"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Spotify App Remote SDK reads this redirect URI back after login -->
        <activity
            android:name="com.spotify.sdk.android.auth.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="voiceassistant" android:host="callback" />
            </intent-filter>
        </activity>

    </application>
</manifest>